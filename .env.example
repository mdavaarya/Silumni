# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── App URL ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Grok / xAI API (PRIMARY — wajib diisi) ───────────────────────────────
# Daftar di: https://console.x.ai
# Klik "API Keys" → Create new key
# Free credits: $25 signup + $150/bulan jika aktifkan data sharing
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Custom Search API (OPSIONAL — fallback jika Grok tidak ada) ───
# Buat API Key: https://console.cloud.google.com → Custom Search JSON API
# Buat CX (Search Engine ID): https://programmablesearchengine.google.com
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# ── SerpAPI (OPSIONAL — untuk Google Scholar) ─────────────────────────────
# Daftar di: https://serpapi.com (100 search/bulan gratis)
SERPAPI_KEY=

# ── GitHub Token (OPSIONAL — meningkatkan rate limit 60→5000 req/jam) ────
GITHUB_TOKEN=

# ── Vercel Cron Secret (WAJIB untuk deploy ke Vercel) ────────────────────
# Isi dengan random string apapun, misal generate dari: openssl rand -hex 32
# Nilai ini harus sama persis antara file .env dan Vercel Environment Variables
CRON_SECRET=isi_dengan_random_string_yang_panjang
